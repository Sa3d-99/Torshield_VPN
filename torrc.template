# ─────────────────────────────────────────────────────────────────────────────
# TorShield — /etc/tor/torrc
#
# This file is generated by install.sh. The placeholders below
# (__SNOWFLAKE_CLIENT__, __OBFS4PROXY__, __USER__) are replaced with the real
# paths detected on THIS machine, so the same config works on any laptop
# regardless of where Tor's helper binaries live.
#
# The block between
#   # >>> TORSHIELD MANAGED BRIDGES — DO NOT EDIT BY HAND <<<
# and
#   # <<< TORSHIELD MANAGED BRIDGES END >>>
# is rewritten automatically by TorShield as it connects. Connection is fully
# automatic (direct → Snowflake → obfs4); obfs4 bridges are fetched from Tor's
# BridgeDB automatically. Edit this block by hand only if the app is closed.
#
# To apply manual changes:  sudo systemctl restart tor   (or reconnect in app)
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ─────────────────────────────────────────────────────────────────────

# SOCKS5 proxy — used by the connection test inside TorShield
SocksPort 9050

# Control port — stem (Python) connects here to read circuits and send NEWNYM
ControlPort 9051

# Transparent proxy — iptables redirects all TCP traffic here
# for system-wide routing (the "Route ALL traffic" switch in TorShield)
TransPort 9040

# DNS through Tor — resolves hostnames anonymously, prevents DNS leaks
DNSPort 5353
AutomapHostsOnResolve 1

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED — without these the circuits panel in TorShield stays empty because
# stem cannot authenticate to the ControlPort.
CookieAuthentication 1
CookieAuthFileGroupReadable 1

# ── Bootstrap resilience ───────────────────────────────────────────────────────
# Give bridges/Snowflake more time before giving up, and keep trying — this is
# the single biggest fix for "it just doesn't connect" on a friend's network.
ClientBootstrapConsensusMaxInProgressTries 6
LearnCircuitBuildTimeout 1

# ── Pluggable-transport plugins ────────────────────────────────────────────────
# Paths are detected and substituted by install.sh. Both transports are declared
# up front so the app can switch between them without rewriting plugin lines.
ClientTransportPlugin snowflake exec __SNOWFLAKE_CLIENT__ -log /home/__USER__/snowflake.log -url https://snowflake-broker.torproject.net/ -front foursquare.com -ice stun:stun.l.google.com:19302,stun:stun.antisip.com:3478
ClientTransportPlugin obfs4 exec __OBFS4PROXY__

# ── Data directory ─────────────────────────────────────────────────────────────
# /var/lib/tor is the default. TorShield automatically falls back to
# ~/.local/share/torshield/tor-data when /var/lib/tor is not writable, so you
# normally do not change this.
# DataDirectory /var/lib/tor

# >>> TORSHIELD MANAGED BRIDGES — DO NOT EDIT BY HAND <<<
# Default mode: AUTO. Snowflake is enabled because it needs no fresh bridge
# certificates and reliably works on censored networks (Egypt, Iran, etc.).
# TorShield's "Auto" mode will first try a direct connection, and only fall
# back to the bridges below if the direct attempt fails to bootstrap.
UseBridges 1
Bridge snowflake 192.0.2.3:80 2B280B23E1107BB62ABFC40DDCC8824814F80A72 fingerprint=2B280B23E1107BB62ABFC40DDCC8824814F80A72 url=https://snowflake-broker.torproject.net/ front=foursquare.com
# obfs4 bridges (optional, for when Snowflake is slow). Get fresh ones from
# https://bridges.torproject.org (choose obfs4), paste them in the app's
# "obfs4" mode, or add them here as:
#   Bridge obfs4 <IP>:<PORT> <FINGERPRINT> cert=<CERT> iat-mode=0
# <<< TORSHIELD MANAGED BRIDGES END >>>
