# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.spec
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build output (binaries built locally, never commit) ──────────────────────
# The compiled exe/installer are built by users; only the build scripts are tracked.
dist/
build/
Output/
*.spec
!TorShield.spec      # keep the committed Windows build spec
TorShield.exe
TorShield-Setup*.exe
# Nuitka intermediates
*.build/
*.dist/
*.onefile-build/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tor runtime files (never commit these) ───────────────────────────────────
*.log
snowflake.log
cached-certs
cached-microdesc*
lock
state
tor.pid

# ── Sensitive / local config ──────────────────────────────────────────────────
# Do NOT commit torrc — it may contain bridge credentials
# Users create their own from the template in docs/
torrc
torrc.local
torshield.conf
graphify-out/
.claude/

# ── Windows runtime (downloaded / generated locally, never commit) ────────────
# Tor + helper binaries are fetched into %APPDATA%\TorShield at runtime; ignore
# these in case anyone bundles them next to the project.
tor/
tun2socks/
*.exe
*.dll
wintun*.zip
tun2socks*.zip
tun_diag_output.txt
*.tmp
*.bak
